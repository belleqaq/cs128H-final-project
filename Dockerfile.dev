# Dev-only image: Rust toolchain + rustfmt + clippy.
# Source code is NOT baked in — it's bind-mounted at runtime via docker-compose.
FROM rust:1-slim

# System deps: build-essential for native crates, pkg-config + libssl-dev for
# anything linking OpenSSL, ca-certificates for crates.io TLS.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Rust components.
RUN rustup component add rustfmt clippy

WORKDIR /app

# Default: drop into a shell. Override with `docker compose run dev <cmd>`.
CMD ["bash"]
